@model DAKKN.Application.DTOs.ProductDto
@inject IStringLocalizer<Messages> Localizer
@{
    var images = (Model.Images is { Count: > 0 })
        ? Model.Images.Where(i => !string.IsNullOrWhiteSpace(i)).ToList()
        : new List<string>();

    if (images.Count == 0)
    {
        var fallback = string.IsNullOrEmpty(Model.ImageFullUrl) ? Model.ImageUrl : Model.ImageFullUrl;
        if (!string.IsNullOrWhiteSpace(fallback))
        {
            if (fallback.Contains(';'))
            {
                images.AddRange(fallback.Split(';', StringSplitOptions.RemoveEmptyEntries).Select(s => s.Trim()));
            }
            else
            {
                images.Add(fallback);
            }
        }
    }

    images = images
        .Where(i => !string.IsNullOrWhiteSpace(i))
        .Select(i => i.StartsWith("http") || i.StartsWith("/") ? i : $"/files/{System.IO.Path.GetFileName(i)}")
        .Distinct()
        .ToList();

    if (images.Count == 0)
    {
        images.Add("/images/placeholders/product-placeholder.svg");
    }

    var isArabic = System.Globalization.CultureInfo.CurrentCulture.Name.StartsWith("ar");
    var alt = isArabic ? Model.ArName : Model.Name;

    var frameClass = ViewData["galleryFrameClass"] as string
        ?? "aspect-square rounded-[32px] bg-surface-container-low dark:bg-[#0d1a2a] border border-outline-variant/10 overflow-hidden shadow-lg";
    var showActions = ViewData["galleryShowActions"] is true;
    var isFavorited = ViewData["IsFavorited"] is true;
    var placeholder = "/images/placeholders/product-placeholder.svg";

    var thumbLabel = Localizer["product_gallery_thumb_label"].Value;
    var counterTemplate = Localizer["product_gallery_counter"].Value;
    var prevLabel = Localizer["product_gallery_prev"].Value;
    var nextLabel = Localizer["product_gallery_next"].Value;
    var scrollLeftLabel = Localizer["product_gallery_scroll_left"].Value;
    var scrollRightLabel = Localizer["product_gallery_scroll_right"].Value;
}

<div class="product-gallery w-full select-none" data-gallery>
    <!-- Main Image Display Container -->
    <div class="@frameClass relative group overflow-hidden">
        <img data-gallery-main
             src="@images[0]"
             alt="@alt"
             class="w-full h-full object-cover transition-all duration-500 ease-out group-hover:scale-105"
             onerror="this.onerror=null; this.src='@placeholder'" />

        @if (images.Count > 1)
        {
            <!-- Navigation Arrows over main image -->
            <button type="button"
                    data-gallery-prev
                    class="absolute ltr:left-3 rtl:right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 dark:bg-slate-900/80 backdrop-blur-md shadow-lg border border-white/20 text-slate-700 dark:text-slate-200 flex items-center justify-center opacity-90 sm:opacity-0 sm:group-hover:opacity-100 transition-all duration-300 hover:scale-110 active:scale-95 hover:bg-white dark:hover:bg-slate-900 z-10"
                    title="@prevLabel"
                    aria-label="@prevLabel">
                <span class="material-symbols-outlined text-xl">@(isArabic ? "chevron_right" : "chevron_left")</span>
            </button>
            <button type="button"
                    data-gallery-next
                    class="absolute ltr:right-3 rtl:left-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-full bg-white/80 dark:bg-slate-900/80 backdrop-blur-md shadow-lg border border-white/20 text-slate-700 dark:text-slate-200 flex items-center justify-center opacity-90 sm:opacity-0 sm:group-hover:opacity-100 transition-all duration-300 hover:scale-110 active:scale-95 hover:bg-white dark:hover:bg-slate-900 z-10"
                    title="@nextLabel"
                    aria-label="@nextLabel">
                <span class="material-symbols-outlined text-xl">@(isArabic ? "chevron_left" : "chevron_right")</span>
            </button>

            <!-- Image counter badge -->
            <div class="absolute bottom-3 ltr:right-3 rtl:left-3 px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-white text-xs font-bold shadow-md flex items-center gap-1.5 z-10 tabular-nums">
                <span class="material-symbols-outlined text-xs">photo_library</span>
                <span data-gallery-counter data-template="@counterTemplate" data-total="@images.Count">
                    @(counterTemplate.Contains("{0}") ? counterTemplate.Replace("{0}", "1").Replace("{1}", images.Count.ToString()) : $"1 / {images.Count}")
                </span>
            </div>
        }

        @if (showActions)
        {
            <div class="absolute top-4 ltr:right-4 rtl:left-4 flex flex-col gap-2 z-10">
                <button type="button" id="fav-top-btn" onclick="toggleFav('@Model.Id', this)"
                        class="w-10 h-10 rounded-full bg-white/90 dark:bg-slate-900/90 backdrop-blur-md shadow-md flex items-center justify-center transition-all hover:scale-110 active:scale-95 @(isFavorited ? "text-error" : "text-slate-600 dark:text-slate-300 hover:text-error")">
                    <span class="material-symbols-outlined text-lg @(isFavorited ? "filled-icon" : "")">favorite</span>
                </button>
            </div>
        }
    </div>

    @if (images.Count > 1)
    {
        <!-- Horizontal Scrollable Thumbnail Strip -->
        <div class="relative mt-4 group/strip">
            <!-- Scroll Track Left Button -->
            <button type="button"
                    data-strip-prev
                    class="hidden sm:flex absolute ltr:-left-3 rtl:-right-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white dark:bg-slate-800 shadow-md border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 items-center justify-center hover:bg-primary hover:text-white transition-all z-20"
                    title="@scrollLeftLabel"
                    aria-label="@scrollLeftLabel">
                <span class="material-symbols-outlined text-base">@(isArabic ? "arrow_forward_ios" : "arrow_back_ios")</span>
            </button>

            <!-- Thumbnails Container with smooth snap scrolling -->
            <div data-gallery-strip class="flex items-center gap-2.5 overflow-x-auto scroll-smooth py-1 px-1 scrollbar-none snap-x snap-mandatory">
                @for (var i = 0; i < images.Count; i++)
                {
                    var src = images[i];
                    var isFirst = i == 0;
                    <button type="button"
                            data-gallery-thumb
                            data-full="@src"
                            data-index="@i"
                            class="shrink-0 w-16 h-16 sm:w-20 sm:h-20 rounded-2xl overflow-hidden border-2 transition-all duration-200 snap-start relative group/thumb cursor-pointer @(isFirst ? "border-primary ring-2 ring-primary/30 shadow-md scale-102" : "border-slate-200 dark:border-slate-700 hover:border-primary/60 opacity-70 hover:opacity-100")"
                            aria-label="@(thumbLabel.Contains("{0}") ? thumbLabel.Replace("{0}", (i + 1).ToString()).Replace("{1}", images.Count.ToString()) : $"Image {i + 1}")"
                            aria-current="@(isFirst ? "true" : "false")">
                        <img src="@src" alt="" class="w-full h-full object-cover transition-transform duration-300 group-hover/thumb:scale-110 pointer-events-none" loading="lazy"
                             onerror="this.onerror=null; this.src='@placeholder'" />
                    </button>
                }
            </div>

            <!-- Scroll Track Right Button -->
            <button type="button"
                    data-strip-next
                    class="hidden sm:flex absolute ltr:-right-3 rtl:-left-3 top-1/2 -translate-y-1/2 w-8 h-8 rounded-full bg-white dark:bg-slate-800 shadow-md border border-slate-200 dark:border-slate-700 text-slate-600 dark:text-slate-300 items-center justify-center hover:bg-primary hover:text-white transition-all z-20"
                    title="@scrollRightLabel"
                    aria-label="@scrollRightLabel">
                <span class="material-symbols-outlined text-base">@(isArabic ? "arrow_back_ios" : "arrow_forward_ios")</span>
            </button>
        </div>
    }
</div>

<script>
(function () {
    const ACTIVE_CLASSES = ['border-primary', 'ring-2', 'ring-primary/30', 'shadow-md', 'scale-102'];
    const INACTIVE_CLASSES = ['border-slate-200', 'dark:border-slate-700', 'opacity-70'];

    document.querySelectorAll('[data-gallery]').forEach(gallery => {
        if (gallery.__galleryInitialized) return;
        gallery.__galleryInitialized = true;

        const main = gallery.querySelector('[data-gallery-main]');
        const thumbs = Array.from(gallery.querySelectorAll('[data-gallery-thumb]'));
        const counter = gallery.querySelector('[data-gallery-counter]');
        const prevBtn = gallery.querySelector('[data-gallery-prev]');
        const nextBtn = gallery.querySelector('[data-gallery-next]');
        const strip = gallery.querySelector('[data-gallery-strip]');
        const stripPrev = gallery.querySelector('[data-strip-prev]');
        const stripNext = gallery.querySelector('[data-strip-next]');

        if (!main || thumbs.length === 0) return;

        let currentIndex = 0;
        const total = thumbs.length;
        const isRtl = document.documentElement.dir === 'rtl' || getComputedStyle(gallery).direction === 'rtl';

        function mark(thumb, active) {
            ACTIVE_CLASSES.forEach(c => thumb.classList.toggle(c, active));
            INACTIVE_CLASSES.forEach(c => thumb.classList.toggle(c, !active));
            thumb.classList.toggle('opacity-100', active);
            thumb.setAttribute('aria-current', active ? 'true' : 'false');
        }

        function updateCounter(index) {
            if (!counter) return;
            const tpl = counter.dataset.template || '';
            if (tpl.includes('{0}')) {
                counter.textContent = tpl.replace('{0}', String(index + 1)).replace('{1}', String(total));
            } else {
                counter.textContent = (index + 1) + ' / ' + total;
            }
        }

        function select(index, scrollStrip = true) {
            if (index < 0) index = total - 1;
            if (index >= total) index = 0;
            currentIndex = index;

            const targetThumb = thumbs[currentIndex];
            if (!targetThumb) return;

            // Fade transition on main image
            main.style.opacity = '0.4';
            setTimeout(() => {
                main.src = targetThumb.dataset.full;
                main.alt = targetThumb.getAttribute('aria-label') || main.alt;
                main.style.opacity = '1';
            }, 120);

            thumbs.forEach((t, i) => mark(t, i === currentIndex));
            updateCounter(currentIndex);

            if (scrollStrip && strip && targetThumb) {
                targetThumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
        }

        thumbs.forEach((thumb, index) => {
            thumb.addEventListener('click', () => select(index, true));
        });

        if (prevBtn) {
            prevBtn.addEventListener('click', (e) => {
                e.preventDefault();
                select(currentIndex - 1, true);
            });
        }

        if (nextBtn) {
            nextBtn.addEventListener('click', (e) => {
                e.preventDefault();
                select(currentIndex + 1, true);
            });
        }

        if (strip && stripPrev) {
            stripPrev.addEventListener('click', () => {
                const amount = isRtl ? 160 : -160;
                strip.scrollBy({ left: amount, behavior: 'smooth' });
            });
        }

        if (strip && stripNext) {
            stripNext.addEventListener('click', () => {
                const amount = isRtl ? -160 : 160;
                strip.scrollBy({ left: amount, behavior: 'smooth' });
            });
        }

        // Swipe Gestures for touch & mobile devices
        let startX = 0;
        let startY = 0;
        const mainContainer = main.closest('.group');

        if (mainContainer) {
            mainContainer.addEventListener('touchstart', (e) => {
                if (e.touches.length === 1) {
                    startX = e.touches[0].clientX;
                    startY = e.touches[0].clientY;
                }
            }, { passive: true });

            mainContainer.addEventListener('touchend', (e) => {
                if (!startX || e.changedTouches.length !== 1) return;
                const diffX = e.changedTouches[0].clientX - startX;
                const diffY = e.changedTouches[0].clientY - startY;
                startX = 0;

                // Only horizontal swipes with at least 40px delta
                if (Math.abs(diffX) > Math.abs(diffY) && Math.abs(diffX) > 40) {
                    if (isRtl) {
                        if (diffX > 0) select(currentIndex + 1, true);
                        else select(currentIndex - 1, true);
                    } else {
                        if (diffX > 0) select(currentIndex - 1, true);
                        else select(currentIndex + 1, true);
                    }
                }
            }, { passive: true });
        }

        // Keyboard arrow navigation
        gallery.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowRight') {
                e.preventDefault();
                select(isRtl ? currentIndex - 1 : currentIndex + 1, true);
            } else if (e.key === 'ArrowLeft') {
                e.preventDefault();
                select(isRtl ? currentIndex + 1 : currentIndex - 1, true);
            }
        });
    });
})();
</script>