@model GuestCartViewModel
@inject IStringLocalizer<Messages> Localizer
@{
    Layout = "_LayoutLanding";
    ViewData["Title"] = Localizer["checkout_h1"];
    var isAr = System.Threading.Thread.CurrentThread.CurrentUICulture.Name.StartsWith("ar");
    var backIcon = isAr ? "arrow_forward" : "arrow_back";
    var nextIcon = isAr ? "arrow_back" : "arrow_forward";
    var govName = isAr && !string.IsNullOrEmpty(Model.GovernorateArName) ? Model.GovernorateArName : Model.GovernorateName;
    var cartSubtotal = Model.Items.Sum(i => i.Price * i.Quantity);
}

<div class="bg-surface dark:bg-[#080e1a] min-h-screen pt-28 pb-16 px-4 md:px-16">
    <div class="max-w-7xl mx-auto">
        <!-- Top Header & Back Link -->
        <div class="mb-8 flex items-center justify-between gap-4">
            <div class="flex items-center gap-4">
                <a asp-action="Cart" class="w-11 h-11 rounded-2xl bg-surface dark:bg-[#0d1a2a] border border-outline-variant/20 dark:border-white/5 flex items-center justify-center text-on-surface-variant dark:text-slate-400 hover:text-primary transition-all" title="@Localizer["cart_continue_shopping"]">
                    <span class="material-symbols-outlined">@backIcon</span>
                </a>
                <div>
                    <h1 class="text-2xl md:text-3xl font-extrabold text-on-surface dark:text-white">@Localizer["checkout_h1"]</h1>
                    <p class="text-xs md:text-sm text-on-surface-variant dark:text-slate-400 mt-1">@Localizer["checkout_shipping_p"]</p>
                </div>
            </div>

            <div class="hidden sm:flex items-center gap-2 px-4 py-2 rounded-2xl bg-primary/10 text-primary text-xs font-bold border border-primary/20">
                <span class="material-symbols-outlined text-base">verified_user</span>
                <span>@Localizer["checkout_pay_cod"]</span>
            </div>
        </div>

        <!-- Empty State View -->
        <div id="checkout-empty-state" class="@(Model.IsEmpty ? "" : "hidden") bg-surface-container-low dark:bg-[#0d1a2a] rounded-[32px] border border-outline-variant/10 p-12 text-center max-w-xl mx-auto space-y-6">
            <div class="w-20 h-20 rounded-full bg-primary/10 text-primary flex items-center justify-center mx-auto text-4xl">
                <span class="material-symbols-outlined text-4xl">shopping_cart</span>
            </div>
            <div class="space-y-2">
                <h2 class="text-2xl font-bold text-on-surface dark:text-white">@Localizer["cart_empty_h"]</h2>
                <p class="text-on-surface-variant dark:text-slate-400 text-sm">@Localizer["cart_empty_p"]</p>
            </div>
            <a asp-action="Products" class="inline-flex items-center gap-2 bg-primary text-on-primary px-8 py-4 rounded-2xl font-bold hover:shadow-large transition-all">
                @Localizer[LocalizationKeys.CartMessages.BrowseProducts.Key]
                <span class="material-symbols-outlined text-sm">@nextIcon</span>
            </a>
        </div>

        @if (!Model.IsEmpty)
        {
            <div id="checkout-main-content">
                <!-- Stepper Progress Tracker (4 Steps) -->
                <div class="mb-10 bg-surface-container-low dark:bg-[#0d1a2a] rounded-[28px] border border-outline-variant/10 p-4 md:p-6 shadow-sm">
                    <div class="relative flex items-center justify-between max-w-4xl mx-auto">
                        <!-- Background Line -->
                        <div class="absolute top-1/2 -translate-y-1/2 start-8 end-8 h-1 bg-surface-container-high dark:bg-white/10 rounded-full -z-0"></div>
                        <!-- Active Progress Line -->
                        <div id="stepper-progress-bar" class="absolute top-1/2 -translate-y-1/2 start-8 h-1 bg-primary rounded-full transition-all duration-500 -z-0" style="width: 0%;"></div>

                        <!-- Step 1 Button: سلة المشتريات والمنتجات -->
                        <button type="button" onclick="goToStep(1)" id="step-nav-1" class="step-nav-btn relative z-10 flex flex-col items-center gap-2 group focus:outline-none">
                            <div class="step-icon-circle w-11 h-11 md:w-13 md:h-13 rounded-2xl flex items-center justify-center text-lg md:text-xl font-bold transition-all duration-300 ring-4 ring-primary/20 bg-primary text-on-primary shadow-md scale-105">
                                <span class="material-symbols-outlined text-2xl">shopping_bag</span>
                            </div>
                            <div class="text-center">
                                <span class="step-label block text-xs md:text-sm font-bold text-primary transition-colors">@Localizer["stepper_step1_cart_title"]</span>
                                <span class="hidden md:block text-[11px] text-on-surface-variant dark:text-slate-400">@Localizer["stepper_step1_cart_desc"]</span>
                            </div>
                        </button>

                        <!-- Step 2 Button: المحافظة والشحن -->
                        <button type="button" onclick="goToStep(2)" id="step-nav-2" class="step-nav-btn relative z-10 flex flex-col items-center gap-2 group focus:outline-none">
                            <div class="step-icon-circle w-11 h-11 md:w-13 md:h-13 rounded-2xl flex items-center justify-center text-lg md:text-xl font-bold transition-all duration-300 ring-4 ring-surface dark:ring-[#0d1a2a] bg-surface-container dark:bg-white/10 text-on-surface-variant dark:text-slate-400 border border-outline-variant/20 dark:border-white/5">
                                <span class="material-symbols-outlined text-2xl">local_shipping</span>
                            </div>
                            <div class="text-center">
                                <span class="step-label block text-xs md:text-sm font-medium text-on-surface-variant dark:text-slate-400 transition-colors">@Localizer["stepper_step1_title"]</span>
                                <span class="hidden md:block text-[11px] text-on-surface-variant dark:text-slate-400">@Localizer["stepper_step1_desc"]</span>
                            </div>
                        </button>

                        <!-- Step 3 Button: بيانات التوصيل -->
                        <button type="button" onclick="goToStep(3)" id="step-nav-3" class="step-nav-btn relative z-10 flex flex-col items-center gap-2 group focus:outline-none">
                            <div class="step-icon-circle w-11 h-11 md:w-13 md:h-13 rounded-2xl flex items-center justify-center text-lg md:text-xl font-bold transition-all duration-300 ring-4 ring-surface dark:ring-[#0d1a2a] bg-surface-container dark:bg-white/10 text-on-surface-variant dark:text-slate-400 border border-outline-variant/20 dark:border-white/5">
                                <span class="material-symbols-outlined text-2xl">badge</span>
                            </div>
                            <div class="text-center">
                                <span class="step-label block text-xs md:text-sm font-medium text-on-surface-variant dark:text-slate-400 transition-colors">@Localizer["stepper_step2_title"]</span>
                                <span class="hidden md:block text-[11px] text-on-surface-variant dark:text-slate-400">@Localizer["stepper_step2_desc"]</span>
                            </div>
                        </button>

                        <!-- Step 4 Button: مراجعة وتأكيد -->
                        <button type="button" onclick="goToStep(4)" id="step-nav-4" class="step-nav-btn relative z-10 flex flex-col items-center gap-2 group focus:outline-none">
                            <div class="step-icon-circle w-11 h-11 md:w-13 md:h-13 rounded-2xl flex items-center justify-center text-lg md:text-xl font-bold transition-all duration-300 ring-4 ring-surface dark:ring-[#0d1a2a] bg-surface-container dark:bg-white/10 text-on-surface-variant dark:text-slate-400 border border-outline-variant/20 dark:border-white/5">
                                <span class="material-symbols-outlined text-2xl">fact_check</span>
                            </div>
                            <div class="text-center">
                                <span class="step-label block text-xs md:text-sm font-medium text-on-surface-variant dark:text-slate-400 transition-colors">@Localizer["stepper_step3_title"]</span>
                                <span class="hidden md:block text-[11px] text-on-surface-variant dark:text-slate-400">@Localizer["stepper_step3_desc"]</span>
                            </div>
                        </button>
                    </div>
                </div>

                <form id="checkout-form" asp-action="PlaceOrder" method="post" class="grid grid-cols-1 lg:grid-cols-3 gap-8 md:gap-10 items-start">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ShippingGovernorateId" id="selected-gov-id" value="@Model.ShippingGovernorateId" />

                    <!-- Main Stepper Content Area (2 Columns) -->
                    <div class="lg:col-span-2 space-y-6">

                        <!-- STEP 1: مراجعة وتعديل سلة المشتريات والمنتجات -->
                        <div id="step-pane-1" class="step-pane transition-all duration-300">
                            <section class="bg-surface-container-low dark:bg-[#0d1a2a] rounded-[32px] border border-outline-variant/10 p-6 md:p-8 shadow-sm space-y-6">
                                <div class="flex items-start justify-between gap-4 border-b border-outline-variant/10 dark:border-white/5 pb-6">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary flex-shrink-0">
                                            <span class="material-symbols-outlined text-2xl">shopping_bag</span>
                                        </div>
                                        <div>
                                            <h2 class="text-xl md:text-2xl font-bold text-on-surface dark:text-white">@Localizer["stepper_step1_cart_heading"]</h2>
                                            <p class="text-sm text-on-surface-variant dark:text-slate-400 mt-1">@Localizer["stepper_step1_cart_subheading"]</p>
                                        </div>
                                    </div>
                                    <span class="hidden sm:inline-flex px-3 py-1 rounded-full bg-primary/10 text-primary font-bold text-xs">
                                        1 / 4
                                    </span>
                                </div>

                                <!-- Cart Items List in Stepper -->
                                <div id="checkout-cart-items-list" class="space-y-4 divide-y divide-outline-variant/10 dark:divide-white/5">
                                    @foreach (var item in Model.Items)
                                    {
                                        var itemTotal = item.Price * item.Quantity;
                                        var currentItemName = isAr && !string.IsNullOrEmpty(item.ArName) ? item.ArName : item.Name;
                                        <div class="checkout-cart-item pt-4 first:pt-0 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 transition-all duration-300" data-product-id="@item.ProductId" data-price="@item.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                                            <div class="flex items-center gap-4 min-w-0">
                                                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-surface dark:bg-[#080e1a] overflow-hidden flex-shrink-0 border border-outline-variant/20 dark:border-white/5 p-1">
                                                    <img src="@(item.ImageUrl ?? "/images/placeholders/product-placeholder.svg")" alt="@currentItemName" class="w-full h-full object-cover rounded-xl" onerror="this.src='/images/placeholders/product-placeholder.svg'">
                                                </div>
                                                <div class="min-w-0">
                                                    <h3 class="font-bold text-base text-on-surface dark:text-white truncate">@currentItemName</h3>
                                                    <p class="text-xs text-on-surface-variant dark:text-slate-400 mt-1">@Localizer["cart_unit"]: @item.Price.ToString("N0") @Html.Raw(Localizer["Currency_EGP"])</p>
                                                </div>
                                            </div>

                                            <div class="flex items-center justify-between sm:justify-end gap-5 w-full sm:w-auto self-stretch sm:self-center pt-2 sm:pt-0 border-t sm:border-t-0 border-outline-variant/10">
                                                <!-- Quantity Stepper Controls -->
                                                <div class="flex items-center gap-2 bg-surface dark:bg-[#080e1a] p-1 rounded-2xl border border-outline-variant/20 dark:border-white/5">
                                                    <button type="button" onclick="updateCheckoutQty('@item.ProductId', -1)" class="w-8 h-8 rounded-xl bg-surface-container-low dark:bg-[#0d1a2a] shadow-sm flex items-center justify-center text-on-surface-variant dark:text-slate-400 hover:text-primary hover:bg-primary/10 transition-all font-bold select-none">−</button>
                                                    <span class="checkout-item-qty font-bold text-sm w-8 text-center text-on-surface dark:text-white" data-product-id="@item.ProductId">@item.Quantity</span>
                                                    <button type="button" onclick="updateCheckoutQty('@item.ProductId', 1)" class="w-8 h-8 rounded-xl bg-surface-container-low dark:bg-[#0d1a2a] shadow-sm flex items-center justify-center text-on-surface-variant dark:text-slate-400 hover:text-primary hover:bg-primary/10 transition-all font-bold select-none">+</button>
                                                </div>

                                                <!-- Item Total -->
                                                <div class="text-end min-w-[90px]">
                                                    <span class="checkout-item-total font-extrabold text-base text-primary block" data-product-id="@item.ProductId">@itemTotal.ToString("N0") @Html.Raw(Localizer["Currency_EGP"])</span>
                                                </div>

                                                <!-- Delete Button -->
                                                <button type="button" onclick="removeCheckoutItem('@item.ProductId')" class="w-9 h-9 rounded-xl flex items-center justify-center text-on-surface-variant dark:text-slate-400 hover:text-rose-500 hover:bg-rose-500/10 transition-all" title="@Localizer["supp_delete"]">
                                                    <span class="material-symbols-outlined text-lg">delete</span>
                                                </button>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- Step 1 Actions: Continue Shopping vs Next to Shipping -->
                                <div class="pt-6 border-t border-outline-variant/10 dark:border-white/5 flex flex-col-reverse sm:flex-row items-center justify-between gap-4">
                                    <a asp-action="Products" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl border border-outline-variant/20 dark:border-white/5 text-on-surface-variant dark:text-slate-400 hover:text-on-surface dark:hover:text-white hover:bg-surface-container dark:hover:bg-white/5 font-bold transition-all">
                                        <span class="material-symbols-outlined text-sm">@backIcon</span>
                                        <span>@Localizer[LocalizationKeys.CartMessages.ContinueShopping.Key]</span>
                                    </a>

                                    <button type="button" onclick="validateStep1AndProceed()" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-primary text-on-primary px-8 py-4 rounded-2xl font-bold text-base shadow-medium hover:shadow-large hover:scale-[1.01] active:scale-95 transition-all">
                                        <span>@Localizer["stepper_next"]: @Localizer["stepper_step1_title"]</span>
                                        <span class="material-symbols-outlined text-lg">@nextIcon</span>
                                    </button>
                                </div>
                            </section>
                        </div>

                        <!-- STEP 2: اختيار المحافظة والشحن -->
                        <div id="step-pane-2" class="step-pane hidden transition-all duration-300">
                            <section class="bg-surface-container-low dark:bg-[#0d1a2a] rounded-[32px] border border-outline-variant/10 p-6 md:p-8 shadow-sm space-y-6">
                                <div class="flex items-start justify-between gap-4 border-b border-outline-variant/10 dark:border-white/5 pb-6">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary flex-shrink-0">
                                            <span class="material-symbols-outlined text-2xl">local_shipping</span>
                                        </div>
                                        <div>
                                            <h2 class="text-xl md:text-2xl font-bold text-on-surface dark:text-white">@Localizer["stepper_step1_heading"]</h2>
                                            <p class="text-sm text-on-surface-variant dark:text-slate-400 mt-1">@Localizer["stepper_step1_subheading"]</p>
                                        </div>
                                    </div>
                                    <span class="hidden sm:inline-flex px-3 py-1 rounded-full bg-primary/10 text-primary font-bold text-xs">
                                        2 / 4
                                    </span>
                                </div>

                                <!-- Search Filter Input -->
                                <div class="relative">
                                    <span class="material-symbols-outlined absolute start-4 top-1/2 -translate-y-1/2 text-on-surface-variant dark:text-slate-400">search</span>
                                    <input type="text" id="gov-search-input" oninput="filterGovernorates()" placeholder="@Localizer["stepper_search_gov_ph"]" class="w-full ps-12 pe-4 py-3.5 bg-surface dark:bg-[#080e1a] rounded-2xl border border-outline-variant/20 dark:border-white/5 focus:ring-2 focus:ring-primary outline-none transition-all text-sm font-medium text-on-surface dark:text-white placeholder:text-on-surface-variant/70" autocomplete="off" />
                                </div>

                                <!-- Governorate Cards Grid -->
                                <div id="gov-cards-container" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3.5 max-h-[460px] overflow-y-auto p-1 pe-2 custom-scroll">
                                    @foreach (var gov in Model.Governorates)
                                    {
                                        var isSelected = Model.ShippingGovernorateId == gov.Id;
                                        var currentGovName = isAr ? gov.ArName : gov.Name;
                                        var invariantPrice = gov.ShippingPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
                                        <div class="gov-card cursor-pointer rounded-2xl border p-4 transition-all duration-200 flex flex-col justify-between gap-3 relative select-none hover:shadow-md @(isSelected ? "border-primary bg-primary/10 ring-2 ring-primary/40 shadow-sm selected-gov" : "border-outline-variant/20 dark:border-white/5 bg-surface dark:bg-[#080e1a] hover:border-primary/50")"
                                             data-id="@gov.Id"
                                             data-price="@invariantPrice"
                                             data-name="@currentGovName">
                                            <div class="flex items-start justify-between gap-2 pointer-events-none">
                                                <div class="flex items-center gap-2.5">
                                                    <span class="material-symbols-outlined text-xl @(isSelected ? "text-primary" : "text-on-surface-variant dark:text-slate-400") gov-pin-icon">location_on</span>
                                                    <span class="font-bold text-sm text-on-surface dark:text-white">@currentGovName</span>
                                                </div>
                                                <div class="gov-check-circle w-5 h-5 rounded-full border flex items-center justify-center transition-all @(isSelected ? "border-primary bg-primary text-on-primary" : "border-outline-variant/30 dark:border-white/10 bg-transparent text-transparent")">
                                                    <span class="material-symbols-outlined text-xs">check</span>
                                                </div>
                                            </div>

                                            <div class="flex items-center justify-between pt-2 border-t border-outline-variant/10 dark:border-white/5 text-xs pointer-events-none">
                                                <span class="text-on-surface-variant dark:text-slate-400">@Localizer["cart_shipping"]</span>
                                                <span class="font-bold @(gov.ShippingPrice == 0 ? "text-emerald-500" : "text-primary")">
                                                    @(gov.ShippingPrice > 0 ? $"{gov.ShippingPrice:N0} {Localizer["Currency_EGP"]}" : Localizer["shipping_free"])
                                                </span>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <!-- No Results Message -->
                                <div id="gov-empty-msg" class="hidden text-center py-8 text-on-surface-variant dark:text-slate-400 text-sm">
                                    <span class="material-symbols-outlined text-3xl mb-1 text-on-surface-variant/60">location_off</span>
                                    <p>لا توجد محافظة بهذا الاسم. يرجى تجربة بحث آخر.</p>
                                </div>

                                <!-- Selected Governorate Banner Preview -->
                                <div id="gov-selected-banner" class="rounded-2xl p-4 bg-primary/5 dark:bg-primary/10 border border-primary/20 flex items-center justify-between gap-4 transition-all @(Model.ShippingGovernorateId.HasValue ? "" : "hidden")">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-primary text-on-primary flex items-center justify-center">
                                            <span class="material-symbols-outlined text-xl">check_circle</span>
                                        </div>
                                        <div>
                                            <p class="text-xs text-on-surface-variant dark:text-slate-400 font-medium">@Localizer["checkout_gov_label"]</p>
                                            <p class="font-bold text-sm text-on-surface dark:text-white" id="banner-gov-name">@govName</p>
                                        </div>
                                    </div>
                                    <div class="text-end">
                                        <span class="text-xs text-on-surface-variant dark:text-slate-400 block">@Localizer["checkout_shipping_cost"]</span>
                                        <span class="font-extrabold text-base text-primary" id="banner-shipping-price">@Model.ShippingPrice.ToString("N0") @Html.Raw(Localizer["Currency_EGP"])</span>
                                    </div>
                                </div>

                                <!-- Step 2 Actions: Step Back to Cart vs Next to Delivery -->
                                <div class="pt-6 border-t border-outline-variant/10 dark:border-white/5 flex flex-col-reverse sm:flex-row items-center justify-between gap-4">
                                    <button type="button" onclick="goToStep(1)" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl border border-outline-variant/20 dark:border-white/5 text-on-surface-variant dark:text-slate-400 hover:text-on-surface dark:hover:text-white hover:bg-surface-container dark:hover:bg-white/5 font-bold transition-all">
                                        <span class="material-symbols-outlined text-sm">@backIcon</span>
                                        <span>@Localizer["stepper_prev_cart"]</span>
                                    </button>

                                    <button type="button" onclick="validateStep2AndProceed()" class="btn-step-next w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-primary text-on-primary px-8 py-4 rounded-2xl font-bold text-base shadow-medium hover:shadow-large hover:scale-[1.01] active:scale-95 transition-all">
                                        <span>@Localizer["stepper_next"]: @Localizer["stepper_step2_title"]</span>
                                        <span class="material-symbols-outlined text-lg">@nextIcon</span>
                                    </button>
                                </div>
                            </section>
                        </div>

                        <!-- STEP 3: بيانات التوصيل والمستلم -->
                        <div id="step-pane-3" class="step-pane hidden transition-all duration-300">
                            <section class="bg-surface-container-low dark:bg-[#0d1a2a] rounded-[32px] border border-outline-variant/10 p-6 md:p-8 shadow-sm space-y-6">
                                <div class="flex items-start justify-between gap-4 border-b border-outline-variant/10 dark:border-white/5 pb-6">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary flex-shrink-0">
                                            <span class="material-symbols-outlined text-2xl">badge</span>
                                        </div>
                                        <div>
                                            <h2 class="text-xl md:text-2xl font-bold text-on-surface dark:text-white">@Localizer["stepper_step2_heading"]</h2>
                                            <p class="text-sm text-on-surface-variant dark:text-slate-400 mt-1">@Localizer["stepper_step2_subheading"]</p>
                                        </div>
                                    </div>
                                    <span class="hidden sm:inline-flex px-3 py-1 rounded-full bg-primary/10 text-primary font-bold text-xs">
                                        3 / 4
                                    </span>
                                </div>

                                <div class="grid grid-cols-1 md:grid-cols-2 gap-5 pt-2">
                                    <!-- Full Name -->
                                    <div class="md:col-span-2 space-y-2">
                                        <label for="CustomerName" class="block font-bold text-xs uppercase tracking-wider text-on-surface-variant dark:text-slate-400 px-1">
                                            @Localizer["checkout_name"] <span class="text-error">*</span>
                                        </label>
                                        <div class="relative">
                                            <input required type="text" id="CustomerName" name="CustomerName" class="w-full ps-12 pe-4 py-4 bg-surface dark:bg-[#080e1a] rounded-2xl border border-outline-variant/20 dark:border-white/5 focus:ring-2 focus:ring-primary outline-none transition-all font-medium text-on-surface dark:text-white" placeholder="@Localizer["checkout_name_ph"]">
                                            <span class="material-symbols-outlined absolute start-4 top-1/2 -translate-y-1/2 text-on-surface-variant dark:text-slate-400">person</span>
                                        </div>
                                        <p class="text-xs text-rose-500 hidden" id="err-customer-name">@Localizer["validation_required"]</p>
                                    </div>

                                    <!-- Phone Number -->
                                    <div class="md:col-span-2 space-y-2">
                                        <label for="CustomerPhone" class="block font-bold text-xs uppercase tracking-wider text-on-surface-variant dark:text-slate-400 px-1">
                                            @Localizer["checkout_phone"] <span class="text-error">*</span>
                                        </label>
                                        <div class="flex items-center bg-surface dark:bg-[#080e1a] rounded-2xl border border-outline-variant/20 dark:border-white/5 focus-within:ring-2 focus-within:ring-primary transition-all overflow-hidden">
                                            <div class="px-4 py-4 border-e border-outline-variant/20 dark:border-white/5 bg-surface-container-high dark:bg-white/5 flex items-center gap-2 select-none flex-shrink-0">
                                                <img src="https://flagcdn.com/w20/eg.png" width="20" alt="@Localizer["flag_egypt_alt"]">
                                                <span class="text-sm font-bold text-on-surface dark:text-white" dir="ltr">+20</span>
                                            </div>
                                            <input required type="tel" id="CustomerPhone" name="CustomerPhone" class="flex-1 px-4 py-4 bg-transparent border-none outline-none focus:ring-0 font-medium text-on-surface dark:text-white" placeholder="@Localizer["checkout_phone_ph"]" dir="ltr">
                                        </div>
                                        <p class="text-xs text-rose-500 hidden" id="err-customer-phone">@Localizer["stepper_phone_invalid_err"]</p>
                                    </div>

                                    <!-- Detailed Address -->
                                    <div class="md:col-span-2 space-y-2">
                                        <label for="ShippingAddress" class="block font-bold text-xs uppercase tracking-wider text-on-surface-variant dark:text-slate-400 px-1">
                                            @Localizer["checkout_address"] <span class="text-error">*</span>
                                        </label>
                                        <div class="relative">
                                            <textarea required id="ShippingAddress" name="ShippingAddress" rows="3" class="w-full ps-12 pe-4 py-3 bg-surface dark:bg-[#080e1a] rounded-2xl border border-outline-variant/20 dark:border-white/5 focus:ring-2 focus:ring-primary outline-none transition-all font-medium text-on-surface dark:text-white" placeholder="@Localizer["checkout_address_ph"]"></textarea>
                                            <span class="material-symbols-outlined absolute start-4 top-4 text-on-surface-variant dark:text-slate-400">home_pin</span>
                                        </div>
                                        <p class="text-xs text-rose-500 hidden" id="err-customer-address">@Localizer["validation_required"]</p>
                                    </div>

                                    <!-- Order Notes (Optional) -->
                                    <div class="md:col-span-2 space-y-2">
                                        <label for="Notes" class="block font-bold text-xs uppercase tracking-wider text-on-surface-variant dark:text-slate-400 px-1">
                                            @Localizer["checkout_notes"]
                                        </label>
                                        <div class="relative">
                                            <textarea id="Notes" name="Notes" rows="2" class="w-full ps-12 pe-4 py-3 bg-surface dark:bg-[#080e1a] rounded-2xl border border-outline-variant/20 dark:border-white/5 focus:ring-2 focus:ring-primary outline-none transition-all font-medium text-on-surface dark:text-white" placeholder="@Localizer["checkout_notes_ph"]"></textarea>
                                            <span class="material-symbols-outlined absolute start-4 top-4 text-on-surface-variant dark:text-slate-400">edit_note</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Step 3 Actions: Step Back to Shipping vs Next to Review -->
                                <div class="pt-6 border-t border-outline-variant/10 dark:border-white/5 flex flex-col-reverse sm:flex-row items-center justify-between gap-4">
                                    <button type="button" onclick="goToStep(2)" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl border border-outline-variant/20 dark:border-white/5 text-on-surface-variant dark:text-slate-400 hover:text-on-surface dark:hover:text-white hover:bg-surface-container dark:hover:bg-white/5 font-bold transition-all">
                                        <span class="material-symbols-outlined text-sm">@backIcon</span>
                                        <span>@Localizer["stepper_prev_shipping"]</span>
                                    </button>

                                    <button type="button" onclick="validateStep3AndProceed()" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-primary text-on-primary px-8 py-4 rounded-2xl font-bold text-base shadow-medium hover:shadow-large hover:scale-[1.01] active:scale-95 transition-all">
                                        <span>@Localizer["stepper_next"]: @Localizer["stepper_step3_title"]</span>
                                        <span class="material-symbols-outlined text-lg">@nextIcon</span>
                                    </button>
                                </div>
                            </section>
                        </div>

                        <!-- STEP 4: مراجعة وتأكيد الطلب -->
                        <div id="step-pane-4" class="step-pane hidden transition-all duration-300">
                            <section class="bg-surface-container-low dark:bg-[#0d1a2a] rounded-[32px] border border-outline-variant/10 p-6 md:p-8 shadow-sm space-y-6">
                                <div class="flex items-start justify-between gap-4 border-b border-outline-variant/10 dark:border-white/5 pb-6">
                                    <div class="flex items-center gap-4">
                                        <div class="w-12 h-12 rounded-2xl bg-primary/10 flex items-center justify-center text-primary flex-shrink-0">
                                            <span class="material-symbols-outlined text-2xl">fact_check</span>
                                        </div>
                                        <div>
                                            <h2 class="text-xl md:text-2xl font-bold text-on-surface dark:text-white">@Localizer["stepper_step3_heading"]</h2>
                                            <p class="text-sm text-on-surface-variant dark:text-slate-400 mt-1">@Localizer["stepper_step3_subheading"]</p>
                                        </div>
                                    </div>
                                    <span class="hidden sm:inline-flex px-3 py-1 rounded-full bg-primary/10 text-primary font-bold text-xs">
                                        4 / 4
                                    </span>
                                </div>

                                <!-- Review Cards -->
                                <div class="space-y-4">
                                    <!-- Review Card 1: سلة المشتريات والمنتجات -->
                                    <div class="p-5 rounded-2xl bg-surface dark:bg-[#080e1a] border border-outline-variant/20 dark:border-white/5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                        <div class="flex items-center gap-3.5">
                                            <div class="w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
                                                <span class="material-symbols-outlined text-xl">shopping_bag</span>
                                            </div>
                                            <div>
                                                <p class="text-xs text-on-surface-variant dark:text-slate-400 font-medium">@Localizer["stepper_step1_cart_title"]</p>
                                                <p class="font-bold text-base text-on-surface dark:text-white">
                                                    <span id="review-items-count">@Model.TotalQuantity</span> @Localizer["checkout_qty"]
                                                </p>
                                                <p class="text-xs text-on-surface-variant dark:text-slate-400 mt-0.5" id="review-cart-summary">@Model.Items.Count @Localizer["cart_h1"]</p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-3 self-end sm:self-center">
                                            <span class="font-extrabold text-sm text-primary px-3 py-1.5 rounded-xl bg-primary/10" id="review-subtotal-cost">@cartSubtotal.ToString("N0") @Html.Raw(Localizer["Currency_EGP"])</span>
                                            <button type="button" onclick="goToStep(1)" class="text-xs font-bold text-primary hover:underline px-2 py-1">
                                                @Localizer["stepper_edit"]
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Review Card 2: الشحن والمحافظة -->
                                    <div class="p-5 rounded-2xl bg-surface dark:bg-[#080e1a] border border-outline-variant/20 dark:border-white/5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                        <div class="flex items-center gap-3.5">
                                            <div class="w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
                                                <span class="material-symbols-outlined text-xl">local_shipping</span>
                                            </div>
                                            <div>
                                                <p class="text-xs text-on-surface-variant dark:text-slate-400 font-medium">@Localizer["stepper_step1_title"]</p>
                                                <p class="font-bold text-base text-on-surface dark:text-white" id="review-gov-name">@govName</p>
                                                <p class="text-xs text-on-surface-variant dark:text-slate-400 mt-0.5">@Localizer["stepper_selected_gov_info"]</p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-3 self-end sm:self-center">
                                            <span class="font-extrabold text-sm text-primary px-3 py-1.5 rounded-xl bg-primary/10" id="review-shipping-cost">@Model.ShippingPrice.ToString("N0") @Html.Raw(Localizer["Currency_EGP"])</span>
                                            <button type="button" onclick="goToStep(2)" class="text-xs font-bold text-primary hover:underline px-2 py-1">
                                                @Localizer["stepper_edit"]
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Review Card 3: بيانات المستلم والعنوان -->
                                    <div class="p-5 rounded-2xl bg-surface dark:bg-[#080e1a] border border-outline-variant/20 dark:border-white/5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
                                        <div class="flex items-start gap-3.5">
                                            <div class="w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0 mt-0.5">
                                                <span class="material-symbols-outlined text-xl">person_pin</span>
                                            </div>
                                            <div class="space-y-1">
                                                <p class="text-xs text-on-surface-variant dark:text-slate-400 font-medium">@Localizer["stepper_step2_title"]</p>
                                                <p class="font-bold text-sm text-on-surface dark:text-white" id="review-customer-name">--</p>
                                                <p class="text-xs text-on-surface-variant dark:text-slate-400" id="review-customer-phone" dir="ltr">--</p>
                                                <p class="text-xs text-on-surface-variant dark:text-slate-400 pt-1" id="review-customer-address">--</p>
                                                <p class="text-xs text-on-surface-variant dark:text-slate-400 italic hidden" id="review-customer-notes"></p>
                                            </div>
                                        </div>
                                        <button type="button" onclick="goToStep(3)" class="self-end sm:self-center text-xs font-bold text-primary hover:underline px-2 py-1">
                                            @Localizer["stepper_edit"]
                                        </button>
                                    </div>

                                    <!-- Review Card 4: طريقة الدفع والتأكيد -->
                                    <div class="p-5 rounded-2xl bg-surface dark:bg-[#080e1a] border border-outline-variant/20 dark:border-white/5 flex items-center justify-between gap-4">
                                        <div class="flex items-center gap-3.5">
                                            <div class="w-11 h-11 rounded-xl bg-primary/10 text-primary flex items-center justify-center flex-shrink-0">
                                                <span class="material-symbols-outlined text-xl">payments</span>
                                            </div>
                                            <div>
                                                <p class="text-xs text-on-surface-variant dark:text-slate-400 font-medium">@Localizer["checkout_payment_h"]</p>
                                                <p class="font-bold text-sm text-on-surface dark:text-white">@Localizer["checkout_pay_cod"]</p>
                                                <p class="text-xs text-on-surface-variant dark:text-slate-400 mt-0.5">@Localizer["checkout_pay_cod_p"]</p>
                                            </div>
                                        </div>
                                        <span class="material-symbols-outlined text-primary text-2xl">verified</span>
                                    </div>
                                </div>

                                <!-- Step 4 Actions: Step Back to Delivery vs Submit -->
                                <div class="pt-6 border-t border-outline-variant/10 dark:border-white/5 flex flex-col-reverse sm:flex-row items-center justify-between gap-4">
                                    <button type="button" onclick="goToStep(3)" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl border border-outline-variant/20 dark:border-white/5 text-on-surface-variant dark:text-slate-400 hover:text-on-surface dark:hover:text-white hover:bg-surface-container dark:hover:bg-white/5 font-bold transition-all">
                                        <span class="material-symbols-outlined text-sm">@backIcon</span>
                                        <span>@Localizer["stepper_prev_delivery"]</span>
                                    </button>

                                    <button type="submit" id="btn-submit-order" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 bg-primary text-on-primary px-10 py-4 rounded-2xl font-bold text-lg shadow-large hover:scale-[1.02] active:scale-95 transition-all">
                                        <span class="material-symbols-outlined text-xl">lock</span>
                                        <span id="submit-btn-text">@Localizer["checkout_submit"]</span>
                                        <span id="submit-spinner" class="hidden material-symbols-outlined animate-spin text-xl">progress_activity</span>
                                    </button>
                                </div>
                            </section>
                        </div>
                    </div>

                    <!-- Sticky Order Summary Sidebar (1 Column) -->
                    <aside class="space-y-6 sticky top-24" id="checkout-sidebar">
                        <section class="bg-surface-container-low dark:bg-[#0d1a2a] rounded-[32px] border border-outline-variant/10 p-6 md:p-8 shadow-sm space-y-6">
                            <div class="flex items-center justify-between border-b border-outline-variant/10 dark:border-white/5 pb-4">
                                <h2 class="text-xl font-bold text-on-surface dark:text-white">@Localizer["checkout_summary_h"]</h2>
                                <div class="flex items-center gap-2">
                                    <button type="button" onclick="goToStep(1)" class="text-xs font-bold text-primary hover:underline flex items-center gap-1" title="@Localizer["stepper_step1_cart_title"]">
                                        <span class="material-symbols-outlined text-sm">edit</span>
                                        <span>@Localizer["stepper_edit"]</span>
                                    </button>
                                    <span class="text-xs font-bold text-on-surface-variant dark:text-slate-400 bg-surface dark:bg-[#080e1a] px-2.5 py-1 rounded-xl">
                                        <span id="summary-items-count">@Model.TotalQuantity</span> @Localizer["checkout_qty"]
                                    </span>
                                </div>
                            </div>

                            <!-- Sidebar Items List -->
                            <div id="sidebar-items-list" class="space-y-3.5 max-h-[300px] overflow-y-auto pe-1 custom-scroll divide-y divide-outline-variant/10 dark:divide-white/5">
                                @foreach (var item in Model.Items)
                                {
                                    var itemTotal = item.Price * item.Quantity;
                                    var currentItemName = isAr && !string.IsNullOrEmpty(item.ArName) ? item.ArName : item.Name;
                                    <div class="sidebar-item flex items-center gap-3.5 pt-3.5 first:pt-0" id="sidebar-item-@item.ProductId" data-product-id="@item.ProductId" data-price="@item.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                                        <div class="w-14 h-14 rounded-2xl bg-surface dark:bg-[#080e1a] overflow-hidden flex-shrink-0 border border-outline-variant/20 dark:border-white/5 p-1">
                                            <img src="@(item.ImageUrl ?? "/images/placeholders/product-placeholder.svg")" alt="@currentItemName" class="w-full h-full object-cover rounded-xl" onerror="this.src='/images/placeholders/product-placeholder.svg'">
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <p class="font-bold text-sm text-on-surface dark:text-white truncate">@currentItemName</p>
                                            <p class="text-xs text-on-surface-variant dark:text-slate-400 mt-0.5">
                                                <span class="sidebar-item-qty">@item.Quantity</span> × @item.Price.ToString("N0") @Html.Raw(Localizer["Currency_EGP"])
                                            </p>
                                        </div>
                                        <p class="sidebar-item-total font-bold text-sm text-on-surface dark:text-white whitespace-nowrap">@itemTotal.ToString("N0") @Html.Raw(Localizer["Currency_EGP"])</p>
                                    </div>
                                }
                            </div>

                            <!-- Price Calculations -->
                            <div class="border-t border-outline-variant/10 dark:border-white/5 pt-5 space-y-3 text-sm">
                                <div class="flex justify-between text-on-surface-variant dark:text-slate-400">
                                    <span>@Localizer["order_subtotal"]</span>
                                    <span class="font-bold text-on-surface dark:text-white" id="summary-subtotal">@cartSubtotal.ToString("N0") @Html.Raw(Localizer["Currency_EGP"])</span>
                                </div>
                                <div class="flex justify-between text-on-surface-variant dark:text-slate-400 items-center">
                                    <span>@Localizer["order_shipping"]</span>
                                    <span class="font-bold text-on-surface dark:text-white" id="summary-shipping">
                                        @if (Model.ShippingGovernorateId.HasValue)
                                        {
                                            @($"{Model.ShippingPrice:N0} {Localizer["Currency_EGP"]}")
                                        }
                                        else
                                        {
                                            <span class="text-on-surface-variant/50 font-normal">--</span>
                                        }
                                    </span>
                                </div>
                                <div class="border-t border-outline-variant/10 dark:border-white/5 pt-3 flex justify-between items-end">
                                    <div>
                                        <span class="font-extrabold text-base text-on-surface dark:text-white block">@Localizer["order_total"]</span>
                                        <span class="text-[10px] text-on-surface-variant dark:text-slate-400 uppercase tracking-wider">@Localizer["cart_vat_inc"]</span>
                                    </div>
                                    <span class="font-extrabold text-2xl md:text-3xl text-primary" id="summary-total">
                                        @((cartSubtotal + Model.ShippingPrice).ToString("N0")) @Html.Raw(Localizer["Currency_EGP"])
                                    </span>
                                </div>
                            </div>

                            <!-- Trust Signals -->
                            <div class="pt-4 border-t border-outline-variant/10 dark:border-white/5 space-y-3">
                                <div class="flex items-center gap-3 text-xs text-on-surface-variant dark:text-slate-400">
                                    <span class="material-symbols-outlined text-primary text-lg">local_shipping</span>
                                    <span>@Localizer["stepper_selected_gov_info"]</span>
                                </div>
                                <div class="flex items-center gap-3 text-xs text-on-surface-variant dark:text-slate-400">
                                    <span class="material-symbols-outlined text-primary text-lg">shield</span>
                                    <span>@Localizer["cart_secure_p"]</span>
                                </div>
                            </div>
                        </section>
                    </aside>
                </form>
            </div>
        }
    </div>
</div>

<style>
    .custom-scroll::-webkit-scrollbar {
        width: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
        background: transparent;
    }
    .custom-scroll::-webkit-scrollbar-thumb {
        background-color: rgba(156, 163, 175, 0.4);
        border-radius: 9999px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
        background-color: rgba(156, 163, 175, 0.7);
    }
    .step-pane.active {
        display: block !important;
        animation: fadeInStep 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    .item-removed {
        opacity: 0;
        transform: scale(0.95);
        transition: all 0.3s ease;
    }
    @@keyframes fadeInStep {
        from {
            opacity: 0;
            transform: translateY(6px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
    @@keyframes shake {
        0%, 100% { transform: translateX(0); }
        20%, 60% { transform: translateX(-6px); }
        40%, 80% { transform: translateX(6px); }
    }
    .animate-shake {
        animation: shake 0.4s ease-in-out;
    }
</style>

@section Scripts {
    <script>
        const decodeHtmlEntities = (function() {
            const el = document.createElement('div');
            return function(str) {
                if (str && typeof str === 'string') {
                    el.innerHTML = str;
                    str = el.textContent;
                    el.textContent = '';
                }
                return str;
            };
        })();

        const currencySymbol = decodeHtmlEntities('@Html.Raw(Localizer["Currency_EGP"])');
        let cartSubtotal = @cartSubtotal.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        let selectedGovId = '@(Model.ShippingGovernorateId?.ToString() ?? "")';
        let currentShippingPrice = @Model.ShippingPrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
        let currentStep = 1;

        // Initialize state
        document.addEventListener('DOMContentLoaded', function () {
            // Event delegation for governorate cards selection
            const cardsContainer = document.getElementById('gov-cards-container');
            if (cardsContainer) {
                cardsContainer.addEventListener('click', function (e) {
                    const card = e.target.closest('.gov-card');
                    if (!card) return;
                    const id = card.getAttribute('data-id');
                    const price = parseFloat(card.getAttribute('data-price')) || 0;
                    const name = card.getAttribute('data-name') || '';
                    selectGovernorate(id, price, name);
                });
            }

            // Pre-select if governorate already exists in backend model
            if (selectedGovId) {
                const card = document.querySelector(`.gov-card[data-id="${selectedGovId}"]`);
                if (card) {
                    const price = parseFloat(card.getAttribute('data-price')) || currentShippingPrice;
                    const name = card.getAttribute('data-name') || '';
                    applyGovernorateUi(selectedGovId, price, name);
                }
            }

            goToStep(1, false);

            // Setup form submission prevention on double click
            const form = document.getElementById('checkout-form');
            if (form) {
                form.addEventListener('submit', function (e) {
                    if (!validateStep1(true)) {
                        e.preventDefault();
                        goToStep(1);
                        return;
                    }
                    if (!selectedGovId) {
                        e.preventDefault();
                        goToStep(2);
                        return;
                    }
                    if (!validateStep3(true)) {
                        e.preventDefault();
                        goToStep(3);
                        return;
                    }

                    const submitBtn = document.getElementById('btn-submit-order');
                    const text = document.getElementById('submit-btn-text');
                    const spinner = document.getElementById('submit-spinner');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
                    }
                    if (text && spinner) {
                        text.classList.add('hidden');
                        spinner.classList.remove('hidden');
                    }
                });
            }
        });

        // 4-Step Navigation Logic
        function goToStep(stepNumber, shouldScroll = true) {
            // Safety checks before advancing
            if (stepNumber >= 2) {
                if (!validateStep1(false)) {
                    goToStep(1);
                    return;
                }
            }
            if (stepNumber >= 3) {
                if (!selectedGovId) {
                    shakeStep(2);
                    alert('@Html.Raw(Localizer["stepper_select_gov_err"])');
                    goToStep(2);
                    return;
                }
            }
            if (stepNumber === 4) {
                if (!validateStep3(false)) {
                    goToStep(3);
                    return;
                }
                updateReviewCard();
            }

            currentStep = stepNumber;

            // Toggle Panes (1 to 4)
            for (let i = 1; i <= 4; i++) {
                const pane = document.getElementById(`step-pane-${i}`);
                if (pane) {
                    if (i === stepNumber) {
                        pane.classList.remove('hidden');
                        pane.classList.add('active');
                    } else {
                        pane.classList.add('hidden');
                        pane.classList.remove('active');
                    }
                }
            }

            // Update Stepper Navigation Visuals
            updateStepperNav(stepNumber);

            if (shouldScroll) {
                const formEl = document.getElementById('checkout-form') || document.getElementById('stepper-progress-bar');
                if (formEl) {
                    const y = formEl.getBoundingClientRect().top + window.pageYOffset - 90;
                    window.scrollTo({ top: Math.max(0, y), behavior: 'smooth' });
                }
            }
        }

        function updateStepperNav(activeStep) {
            const progressBar = document.getElementById('stepper-progress-bar');
            if (progressBar) {
                // 4 Steps: 1 -> 0%, 2 -> 33.3%, 3 -> 66.6%, 4 -> 100%
                const pct = activeStep === 1 ? 0 : activeStep === 2 ? 33.3 : activeStep === 3 ? 66.6 : 100;
                progressBar.style.width = `${pct}%`;
            }

            const stepIcons = {
                1: 'shopping_bag',
                2: 'local_shipping',
                3: 'badge',
                4: 'fact_check'
            };

            for (let i = 1; i <= 4; i++) {
                const btn = document.getElementById(`step-nav-${i}`);
                if (!btn) continue;

                const circle = btn.querySelector('.step-icon-circle');
                const label = btn.querySelector('.step-label');

                if (i < activeStep) {
                    // Completed Step
                    circle.className = 'step-icon-circle w-11 h-11 md:w-13 md:h-13 rounded-2xl flex items-center justify-center text-lg md:text-xl font-bold ring-4 ring-surface dark:ring-[#0d1a2a] bg-emerald-500/15 text-emerald-500 border border-emerald-500/30 shadow-sm';
                    circle.innerHTML = '<span class="material-symbols-outlined text-2xl font-bold">check</span>';
                    label.className = 'step-label block text-xs md:text-sm font-bold text-emerald-500';
                } else if (i === activeStep) {
                    // Active Step
                    circle.className = 'step-icon-circle w-11 h-11 md:w-13 md:h-13 rounded-2xl flex items-center justify-center text-lg md:text-xl font-bold ring-4 ring-primary/20 bg-primary text-on-primary shadow-md scale-105';
                    circle.innerHTML = `<span class="material-symbols-outlined text-2xl">${stepIcons[i]}</span>`;
                    label.className = 'step-label block text-xs md:text-sm font-bold text-primary';
                } else {
                    // Upcoming Step
                    circle.className = 'step-icon-circle w-11 h-11 md:w-13 md:h-13 rounded-2xl flex items-center justify-center text-lg md:text-xl font-bold ring-4 ring-surface dark:ring-[#0d1a2a] bg-surface-container dark:bg-white/10 text-on-surface-variant dark:text-slate-400 border border-outline-variant/20 dark:border-white/5';
                    circle.innerHTML = `<span class="material-symbols-outlined text-2xl">${stepIcons[i]}</span>`;
                    label.className = 'step-label block text-xs md:text-sm font-medium text-on-surface-variant dark:text-slate-400';
                }
            }
        }

        // Cart In-Stepper Adjustments: Quantity & Remove
        async function updateCheckoutQty(productId, delta) {
            const qtyEl = document.querySelector(`.checkout-item-qty[data-product-id="${productId}"]`);
            if (!qtyEl) return;
            const currentQty = parseInt(qtyEl.textContent) || 1;
            const newQty = Math.max(1, currentQty + delta);
            if (newQty === currentQty) return;

            try {
                const response = await fetch('/api/v1/cart/update-quantity', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId: productId, quantity: newQty })
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result && result.success) {
                        qtyEl.textContent = newQty;
                        
                        // Update in sidebar as well
                        const sidebarQtyEl = document.querySelector(`#sidebar-item-${productId} .sidebar-item-qty`);
                        if (sidebarQtyEl) sidebarQtyEl.textContent = newQty;

                        updateCartBadges(result.data);
                        recalculateAllTotals();
                    }
                }
            } catch (err) {
                console.error('Failed to update checkout item quantity:', err);
            }
        }

        async function removeCheckoutItem(productId) {
            const itemRow = document.querySelector(`.checkout-cart-item[data-product-id="${productId}"]`);
            const sidebarRow = document.getElementById(`sidebar-item-${productId}`);

            if (itemRow) itemRow.classList.add('item-removed');
            if (sidebarRow) sidebarRow.classList.add('item-removed');

            setTimeout(async () => {
                try {
                    const response = await fetch(`/api/v1/cart/remove/${productId}`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    });

                    if (response.ok) {
                        const result = await response.json();
                        if (result && result.success) {
                            if (itemRow) itemRow.remove();
                            if (sidebarRow) sidebarRow.remove();
                            updateCartBadges(result.data);
                            recalculateAllTotals();
                            checkIfEmptyCart();
                        }
                    }
                } catch (err) {
                    console.error('Failed to remove checkout item:', err);
                }
            }, 250);
        }

        function recalculateAllTotals() {
            let subtotal = 0;
            let totalQty = 0;

            const items = document.querySelectorAll('.checkout-cart-item');
            items.forEach(item => {
                const qtyEl = item.querySelector('.checkout-item-qty');
                const qty = parseInt(qtyEl?.textContent) || 0;
                const price = parseFloat(item.getAttribute('data-price')) || 0;
                const itemTotal = qty * price;

                subtotal += itemTotal;
                totalQty += qty;

                // Update Step 1 Item Total
                const totalEl = item.querySelector('.checkout-item-total');
                if (totalEl) {
                    totalEl.innerHTML = `${itemTotal.toFixed(0)} ${currencySymbol}`;
                }

                // Update Sidebar Item Total
                const productId = item.getAttribute('data-product-id');
                const sidebarItem = document.getElementById(`sidebar-item-${productId}`);
                if (sidebarItem) {
                    const sidebarTotalEl = sidebarItem.querySelector('.sidebar-item-total');
                    const sidebarQtyEl = sidebarItem.querySelector('.sidebar-item-qty');
                    if (sidebarTotalEl) sidebarTotalEl.innerHTML = `${itemTotal.toFixed(0)} ${currencySymbol}`;
                    if (sidebarQtyEl) sidebarQtyEl.textContent = qty;
                }
            });

            cartSubtotal = subtotal;

            // Update Subtotal Displays
            const subtotalEl = document.getElementById('summary-subtotal');
            const reviewSubtotalEl = document.getElementById('review-subtotal-cost');
            if (subtotalEl) subtotalEl.innerHTML = `${subtotal.toFixed(0)} ${currencySymbol}`;
            if (reviewSubtotalEl) reviewSubtotalEl.innerHTML = `${subtotal.toFixed(0)} ${currencySymbol}`;

            // Update Total Quantities
            const summaryQtyEl = document.getElementById('summary-items-count');
            const reviewQtyEl = document.getElementById('review-items-count');
            if (summaryQtyEl) summaryQtyEl.textContent = totalQty;
            if (reviewQtyEl) reviewQtyEl.textContent = totalQty;

            // Update Grand Total
            updateSidebarTotals();
        }

        function checkIfEmptyCart() {
            const items = document.querySelectorAll('.checkout-cart-item');
            if (items.length === 0) {
                const mainContent = document.getElementById('checkout-main-content');
                const emptyState = document.getElementById('checkout-empty-state');
                if (mainContent) mainContent.classList.add('hidden');
                if (emptyState) emptyState.classList.remove('hidden');
            }
        }

        function updateCartBadges(count) {
            document.querySelectorAll('[id^="cart-badge"]').forEach(el => el.textContent = count || 0);
        }

        // Governorate Selection (Dynamic Backend Sync)
        async function selectGovernorate(govId, price, name) {
            if (!govId) return;
            selectedGovId = govId;
            currentShippingPrice = parseFloat(price) || 0;

            const hiddenInput = document.getElementById('selected-gov-id');
            if (hiddenInput) hiddenInput.value = govId;

            applyGovernorateUi(govId, currentShippingPrice, name);

            // Dynamic Backend Integration: Sync with Cart API
            try {
                const response = await fetch('/api/v1/cart/shipping', {
                    method: 'PUT',
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({ shippingGovernorateId: govId })
                });

                if (response.ok) {
                    const result = await response.json();
                    if (result && result.success && result.data) {
                        currentShippingPrice = parseFloat(result.data.shippingPrice) || currentShippingPrice;
                        updateSidebarTotals();
                    }
                }
            } catch (err) {
                console.warn('Backend shipping API sync warning:', err);
                updateSidebarTotals();
            }
        }

        function applyGovernorateUi(govId, price, name) {
            if (!govId) return;
            const targetId = govId.toLowerCase();

            document.querySelectorAll('.gov-card').forEach(card => {
                const cardId = (card.getAttribute('data-id') || '').toLowerCase();
                const isSelected = (cardId === targetId);
                const checkCircle = card.querySelector('.gov-check-circle');
                const pinIcon = card.querySelector('.gov-pin-icon');

                if (isSelected) {
                    card.classList.add('border-primary', 'bg-primary/10', 'ring-2', 'ring-primary/40', 'shadow-md', 'selected-gov');
                    card.classList.remove('border-outline-variant/20', 'dark:border-white/5', 'bg-surface', 'dark:bg-[#080e1a]');
                    if (checkCircle) {
                        checkCircle.classList.add('border-primary', 'bg-primary', 'text-on-primary');
                        checkCircle.classList.remove('border-outline-variant/30', 'dark:border-white/10', 'bg-transparent', 'text-transparent');
                    }
                    if (pinIcon) {
                        pinIcon.classList.add('text-primary');
                        pinIcon.classList.remove('text-on-surface-variant', 'dark:text-slate-400');
                    }
                } else {
                    card.classList.remove('border-primary', 'bg-primary/10', 'ring-2', 'ring-primary/40', 'shadow-md', 'selected-gov');
                    card.classList.add('border-outline-variant/20');
                    if (checkCircle) {
                        checkCircle.classList.remove('border-primary', 'bg-primary', 'text-on-primary');
                        checkCircle.classList.add('border-outline-variant/30', 'dark:border-white/10', 'bg-transparent', 'text-transparent');
                    }
                    if (pinIcon) {
                        pinIcon.classList.remove('text-primary');
                        pinIcon.classList.add('text-on-surface-variant');
                    }
                }
            });

            // Update banner preview
            const banner = document.getElementById('gov-selected-banner');
            const bannerName = document.getElementById('banner-gov-name');
            const bannerPrice = document.getElementById('banner-shipping-price');
            if (banner) {
                banner.classList.remove('hidden');
            }
            if (bannerName) {
                bannerName.textContent = name;
            }
            if (bannerPrice) {
                bannerPrice.innerHTML = `${price.toFixed(0)} ${currencySymbol}`;
            }

            // Update review step (Step 4)
            const reviewGovName = document.getElementById('review-gov-name');
            const reviewShippingCost = document.getElementById('review-shipping-cost');
            if (reviewGovName) reviewGovName.textContent = name;
            if (reviewShippingCost) reviewShippingCost.innerHTML = `${price.toFixed(0)} ${currencySymbol}`;

            updateSidebarTotals();
        }

        function updateSidebarTotals() {
            const shippingEl = document.getElementById('summary-shipping');
            const totalEl = document.getElementById('summary-total');

            if (shippingEl) {
                shippingEl.innerHTML = `${currentShippingPrice.toFixed(0)} ${currencySymbol}`;
            }
            if (totalEl) {
                const grandTotal = cartSubtotal + currentShippingPrice;
                totalEl.innerHTML = `${grandTotal.toFixed(0)} ${currencySymbol}`;
            }
        }

        // Live search filtering with Arabic normalization
        function normalizeArabic(text) {
            if (!text) return '';
            return text.toString()
                .toLowerCase()
                .replace(/[إأآا]/g, 'ا')
                .replace(/ة/g, 'ه')
                .replace(/ى/g, 'ي')
                .trim();
        }

        function filterGovernorates() {
            const rawQuery = (document.getElementById('gov-search-input')?.value || '').trim();
            const normalizedQuery = normalizeArabic(rawQuery);
            const cards = document.querySelectorAll('.gov-card');
            let visibleCount = 0;

            cards.forEach(card => {
                const cardName = card.getAttribute('data-name') || '';
                const normalizedCardName = normalizeArabic(cardName);

                if (!normalizedQuery || normalizedCardName.includes(normalizedQuery)) {
                    card.classList.remove('hidden');
                    visibleCount++;
                } else {
                    card.classList.add('hidden');
                }
            });

            const emptyMsg = document.getElementById('gov-empty-msg');
            if (emptyMsg) {
                if (visibleCount === 0) {
                    emptyMsg.classList.remove('hidden');
                } else {
                    emptyMsg.classList.add('hidden');
                }
            }
        }

        // Step 1 Validation (Cart has items)
        function validateStep1AndProceed() {
            if (!validateStep1(true)) {
                return;
            }
            goToStep(2);
        }

        function validateStep1(showAlert = true) {
            const items = document.querySelectorAll('.checkout-cart-item');
            if (items.length === 0) {
                if (showAlert) {
                    alert('@Html.Raw(Localizer["cart_empty_h"])');
                }
                return false;
            }
            return true;
        }

        // Step 2 Validation (Governorate selected)
        function validateStep2AndProceed() {
            if (!selectedGovId) {
                shakeStep(2);
                alert('@Html.Raw(Localizer["stepper_select_gov_err"])');
                return;
            }
            goToStep(3);
        }

        // Step 3 Validation (Customer Details)
        function validateStep3AndProceed() {
            if (validateStep3(true)) {
                goToStep(4);
            }
        }

        function validateStep3(showErrors = true) {
            const name = document.getElementById('CustomerName')?.value.trim();
            const phone = document.getElementById('CustomerPhone')?.value.trim();
            const address = document.getElementById('ShippingAddress')?.value.trim();

            const errName = document.getElementById('err-customer-name');
            const errPhone = document.getElementById('err-customer-phone');
            const errAddress = document.getElementById('err-customer-address');

            let isValid = true;

            // Name validation
            if (!name) {
                if (showErrors && errName) errName.classList.remove('hidden');
                isValid = false;
            } else if (errName) {
                errName.classList.add('hidden');
            }

            // Egyptian Phone validation: 10 or 11 digits, starts with 01 or 1
            const phoneRegex = /^(010|011|012|015)[0-9]{8}$/;
            const cleanPhone = phone ? phone.replace(/[\s-+]/g, '') : '';
            const normalizedPhone = cleanPhone.startsWith('20') ? cleanPhone.substring(2) : cleanPhone;

            if (!phone || (!phoneRegex.test(phone) && !phoneRegex.test('0' + normalizedPhone) && cleanPhone.length < 10)) {
                if (showErrors && errPhone) errPhone.classList.remove('hidden');
                isValid = false;
            } else if (errPhone) {
                errPhone.classList.add('hidden');
            }

            // Address validation
            if (!address || address.length < 5) {
                if (showErrors && errAddress) errAddress.classList.remove('hidden');
                isValid = false;
            } else if (errAddress) {
                errAddress.classList.add('hidden');
            }

            if (!isValid && showErrors) {
                shakeStep(3);
            }

            return isValid;
        }

        // Update Step 4 Review Card
        function updateReviewCard() {
            const card = document.querySelector(`.gov-card[data-id="${selectedGovId}"]`);
            const govName = card ? card.getAttribute('data-name') : '';
            const name = document.getElementById('CustomerName')?.value.trim() || '';
            const phone = document.getElementById('CustomerPhone')?.value.trim() || '';
            const address = document.getElementById('ShippingAddress')?.value.trim() || '';
            const notes = document.getElementById('Notes')?.value.trim() || '';

            const reviewGovName = document.getElementById('review-gov-name');
            const reviewShippingCost = document.getElementById('review-shipping-cost');
            const reviewCustomerName = document.getElementById('review-customer-name');
            const reviewCustomerPhone = document.getElementById('review-customer-phone');
            const reviewCustomerAddress = document.getElementById('review-customer-address');
            const reviewCustomerNotes = document.getElementById('review-customer-notes');

            if (reviewGovName) reviewGovName.textContent = govName;
            if (reviewShippingCost) reviewShippingCost.innerHTML = `${currentShippingPrice.toFixed(0)} ${currencySymbol}`;
            if (reviewCustomerName) reviewCustomerName.textContent = name;
            if (reviewCustomerPhone) reviewCustomerPhone.textContent = phone;
            if (reviewCustomerAddress) reviewCustomerAddress.textContent = address;

            if (reviewCustomerNotes) {
                if (notes) {
                    reviewCustomerNotes.textContent = `ملاحظات: ${notes}`;
                    reviewCustomerNotes.classList.remove('hidden');
                } else {
                    reviewCustomerNotes.classList.add('hidden');
                }
            }
        }

        function shakeStep(stepNum) {
            const pane = document.getElementById(`step-pane-${stepNum}`);
            if (pane) {
                pane.classList.add('animate-shake');
                setTimeout(() => pane.classList.remove('animate-shake'), 600);
            }
        }
    </script>
}
