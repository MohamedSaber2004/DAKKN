@model GuestCartViewModel
@{
    Layout = "_LayoutLanding";
    ViewData["Title"] = Localizer["nav_cart"];
    var isAr = System.Threading.Thread.CurrentThread.CurrentUICulture.Name.StartsWith("ar");
}

@{
    var nextIcon = isAr ? "arrow_back" : "arrow_forward";
    var backIcon = isAr ? "arrow_forward" : "arrow_back";
}

<div class="min-h-screen bg-surface dark:bg-[#080e1a] pt-20 sm:pt-28 pb-24 lg:pb-16 px-3 sm:px-6 lg:px-16">
    <div class="max-w-7xl mx-auto">
        <div class="mb-6 sm:mb-10">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-on-surface dark:text-white mb-2">@Localizer["cart_h1"]</h1>
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full" id="shipping-status-dot"></span>
                <p id="free-shipping-info" class="text-xs sm:text-sm text-on-surface-variant dark:text-slate-400"></p>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8 items-start">
            <div class="lg:col-span-2 space-y-3.5 sm:space-y-4" id="cart-items-container">
                @if (Model.IsEmpty)
                {
                    <div id="cart-empty-state" class="py-16 sm:py-20 text-center bg-surface-container-low dark:bg-[#0d1a2a] rounded-2xl sm:rounded-[32px] border border-outline-variant/10 p-6 sm:p-12">
                        <div class="w-20 h-20 sm:w-24 sm:h-24 bg-surface-container-high dark:bg-white/5 rounded-full flex items-center justify-center mx-auto text-on-surface-variant/30 mb-6">
                            <span class="material-symbols-outlined text-4xl sm:text-5xl">shopping_cart</span>
                        </div>
                        <h2 class="text-xl sm:text-2xl font-bold text-on-surface dark:text-white mb-2">@Localizer["cart_empty_h"]</h2>
                        <p class="text-on-surface-variant dark:text-slate-400 text-xs sm:text-sm max-w-sm mx-auto mb-6 sm:mb-8">@Localizer["cart_empty_p"]</p>
                        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">
                            <a asp-action="Products" asp-controller="Shop" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-primary text-on-primary px-6 sm:px-8 py-3.5 sm:py-4 rounded-2xl font-bold hover:shadow-lg hover:-translate-y-0.5 transition-all text-sm sm:text-base">
                                @Localizer[LocalizationKeys.CartMessages.BrowseProducts.Key] <span class="material-symbols-outlined text-base">@nextIcon</span>
                            </a>
                            <a asp-action="Products" asp-controller="Shop" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 text-on-surface-variant dark:text-slate-400 hover:text-primary font-bold transition-colors px-6 sm:px-8 py-3.5 sm:py-4 text-sm">
                                <span class="material-symbols-outlined text-sm">@backIcon</span>
                                @Localizer[LocalizationKeys.CartMessages.ContinueShopping.Key]
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    foreach (var item in Model.Items)
                    {
                        var currentItemName = isAr && !string.IsNullOrEmpty(item.ArName) ? item.ArName : item.Name;
                        <div class="cart-item group bg-surface-container-low dark:bg-[#0d1a2a] rounded-2xl sm:rounded-[28px] md:rounded-[32px] border border-outline-variant/10 p-3.5 sm:p-5 md:p-6 shadow-sm hover:shadow-md transition-all" data-product-id="@item.ProductId" data-price="@item.Price.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)">
                            <div class="flex items-start gap-3 sm:gap-4 md:gap-5">
                                <div class="w-20 h-20 sm:w-24 sm:h-24 md:w-28 md:h-28 rounded-2xl overflow-hidden bg-surface dark:bg-[#080e1a] border border-outline-variant/10 dark:border-white/5 flex-shrink-0 p-1">
                                    <img src="@(item.ImageUrl ?? "/images/placeholders/product-placeholder.svg")" class="w-full h-full object-cover rounded-xl group-hover:scale-105 transition-transform duration-300" alt="@currentItemName" loading="lazy" onerror="this.src='/images/placeholders/product-placeholder.svg'" />
                                </div>
                                <div class="flex-1 min-w-0 flex flex-col justify-between self-stretch">
                                    <div class="flex justify-between items-start gap-2">
                                        <div class="min-w-0 flex-1">
                                            <h3 class="font-bold text-sm sm:text-base md:text-lg text-on-surface dark:text-white line-clamp-2 group-hover:text-primary transition-colors leading-snug">@currentItemName</h3>
                                            <p class="text-[11px] sm:text-xs text-on-surface-variant dark:text-slate-400 mt-1">@Localizer["cart_unit"]: @item.Price.ToString("N0") @Html.Raw(Localizer["Currency_EGP"])</p>
                                        </div>
                                        <button type="button" onclick="removeItem('@item.ProductId')" class="w-8 h-8 sm:w-9 sm:h-9 rounded-xl flex items-center justify-center text-on-surface-variant dark:text-slate-400 hover:text-rose-500 hover:bg-rose-500/10 transition-all flex-shrink-0" title="@Localizer["supp_delete"]">
                                            <span class="material-symbols-outlined text-lg sm:text-xl">delete</span>
                                        </button>
                                    </div>
                                    <div class="flex items-center justify-between gap-3 mt-3 sm:mt-4 pt-2.5 border-t border-outline-variant/10 dark:border-white/5">
                                        <div class="flex items-center gap-1 sm:gap-2 bg-surface dark:bg-[#080e1a] p-1 rounded-xl sm:rounded-2xl border border-outline-variant/20 dark:border-white/5">
                                            <button type="button" onclick="updateQty('@item.ProductId', -1)" class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg sm:rounded-xl bg-surface-container-low dark:bg-[#0d1a2a] shadow-sm flex items-center justify-center hover:bg-primary hover:text-on-primary transition-all text-on-surface dark:text-white font-bold select-none text-base sm:text-lg">−</button>
                                            <span class="item-qty font-bold text-xs sm:text-sm w-7 sm:w-8 text-center text-on-surface dark:text-white" data-product-id="@item.ProductId">@item.Quantity</span>
                                            <button type="button" onclick="updateQty('@item.ProductId', 1)" class="w-7 h-7 sm:w-8 sm:h-8 rounded-lg sm:rounded-xl bg-surface-container-low dark:bg-[#0d1a2a] shadow-sm flex items-center justify-center hover:bg-primary hover:text-on-primary transition-all text-on-surface dark:text-white font-bold select-none text-base sm:text-lg">+</button>
                                        </div>
                                        <div class="text-end">
                                            <p class="font-extrabold text-base sm:text-lg md:text-xl text-primary item-total">@((item.Price * item.Quantity).ToString("N0")) @Html.Raw(Localizer["Currency_EGP"])</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <!-- Cart Order Summary Sidebar -->
            <aside class="space-y-4 sm:space-y-6 lg:sticky lg:top-28" id="cart-sidebar">
                <div class="bg-surface-container-low dark:bg-[#0d1a2a] rounded-2xl sm:rounded-[32px] border border-outline-variant/10 p-5 sm:p-7 md:p-8 shadow-sm space-y-5 sm:space-y-6">
                    <h2 class="text-xl sm:text-2xl font-bold text-on-surface dark:text-white">@Localizer["cart_summary_h"]</h2>

                    @if (!Model.IsEmpty)
                    {
                        <div class="space-y-3 sm:space-y-4 text-xs sm:text-sm">
                            <div class="flex justify-between text-on-surface-variant dark:text-slate-400">
                                <span>@Localizer["cart_subtotal"] (<span id="summary-items-count">@Model.TotalQuantity</span> @Localizer["cart_items"])</span>
                                <span id="summary-subtotal" class="font-bold text-on-surface dark:text-white">@Model.Subtotal.ToString("N0") @Html.Raw(Localizer["Currency_EGP"])</span>
                            </div>

                            <div class="flex justify-between items-center text-on-surface-variant dark:text-slate-400">
                                <span>@Localizer["cart_shipping"]</span>
                                <span id="summary-shipping" class="text-xs text-on-surface-variant/70 font-medium">
                                    @Localizer[LocalizationKeys.CartMessages.ShippingCalculatedAtCheckout.Key]
                                </span>
                            </div>

                            <div class="h-px bg-outline-variant/10 dark:border-white/5"></div>
                            <div class="flex justify-between items-end">
                                <div>
                                    <span class="font-extrabold text-sm sm:text-base text-on-surface dark:text-white block">@Localizer["cart_total"]</span>
                                    <div class="text-[10px] text-on-surface-variant dark:text-slate-400 uppercase tracking-widest mt-0.5">@Localizer["cart_vat_inc"]</div>
                                </div>
                                <div class="text-end">
                                    <div id="summary-total" class="text-2xl sm:text-3xl font-extrabold text-primary">@Model.Subtotal.ToString("N0") @Html.Raw(Localizer["Currency_EGP"])</div>
                                </div>
                            </div>
                        </div>

                        <a asp-action="Checkout" asp-controller="Shop" class="w-full bg-primary text-on-primary py-4 sm:py-5 rounded-2xl sm:rounded-3xl font-bold text-base sm:text-lg md:text-xl shadow-medium hover:shadow-large hover:scale-[1.01] active:scale-95 transition-all flex items-center justify-center gap-2.5 sm:gap-3">
                            <span>@Localizer["cart_checkout"]</span>
                            <span class="material-symbols-outlined text-lg sm:text-xl">@nextIcon</span>
                        </a>
                    }

                    <div class="flex flex-col gap-2.5 sm:gap-3 pt-2">
                        <div class="flex items-center gap-3 p-3.5 sm:p-4 bg-surface dark:bg-[#080e1a] rounded-2xl border border-outline-variant/10 dark:border-white/5">
                            <span class="material-symbols-outlined text-primary text-xl flex-shrink-0">verified_user</span>
                            <div class="text-xs">
                                <p class="font-bold text-on-surface dark:text-white">@Localizer["cart_secure_h"]</p>
                                <p class="text-on-surface-variant dark:text-slate-400 text-[11px] mt-0.5">@Localizer["cart_secure_p"]</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3 p-3.5 sm:p-4 bg-surface dark:bg-[#080e1a] rounded-2xl border border-outline-variant/10 dark:border-white/5">
                            <span class="material-symbols-outlined text-primary text-xl flex-shrink-0">local_shipping</span>
                            <div class="text-xs">
                                <p class="font-bold text-on-surface dark:text-white">@Localizer["cart_fast_h"]</p>
                                <p class="text-on-surface-variant dark:text-slate-400 text-[11px] mt-0.5">@Localizer["cart_fast_p"]</p>
                            </div>
                        </div>
                    </div>
                </div>

                <a asp-action="Products" asp-controller="Shop" class="flex items-center justify-center gap-2 text-on-surface-variant dark:text-slate-400 hover:text-primary font-bold transition-colors py-2 text-sm sm:text-base">
                    <span class="material-symbols-outlined text-sm">@backIcon</span>
                    <span>@Localizer[LocalizationKeys.CartMessages.ContinueShopping.Key]</span>
                </a>
            </aside>
        </div>
    </div>
</div>

<!-- Mobile Sticky Bottom Checkout Bar (Visible on mobile/tablet screens < lg when cart is not empty) -->
@if (!Model.IsEmpty)
{
    <div id="cart-mobile-sticky-bar" class="block lg:hidden fixed bottom-0 inset-x-0 z-40 bg-surface/95 dark:bg-[#080e1a]/95 backdrop-blur-md border-t border-outline-variant/15 dark:border-white/10 px-4 py-3 shadow-2xl transition-all duration-300">
        <div class="max-w-7xl mx-auto flex items-center justify-between gap-3">
            <div>
                <span class="text-[11px] text-on-surface-variant dark:text-slate-400 block font-medium">@Localizer["order_total"]</span>
                <div id="mobile-sticky-total" class="font-extrabold text-base sm:text-lg text-primary leading-tight">
                    @Model.Subtotal.ToString("N0") @Html.Raw(Localizer["Currency_EGP"])
                </div>
            </div>
            <a asp-action="Checkout" asp-controller="Shop" class="flex-1 max-w-[220px] bg-primary text-on-primary py-3 px-5 rounded-2xl font-bold text-sm sm:text-base shadow-medium hover:shadow-large active:scale-95 transition-all flex items-center justify-center gap-2">
                <span>@Localizer["cart_checkout"]</span>
                <span class="material-symbols-outlined text-base">@nextIcon</span>
            </a>
        </div>
    </div>
}

<style>
    .cart-item {
        animation: slideIn 0.4s ease-out forwards;
    }
    [dir="ltr"] .cart-item {
        animation: slideInLtr 0.4s ease-out forwards;
    }
    [dir="rtl"] .cart-item {
        animation: slideInRtl 0.4s ease-out forwards;
    }
    @@keyframes slideInLtr {
        from { opacity: 0; transform: translateX(-10px); }
        to { opacity: 1; transform: translateX(0); }
    }
    @@keyframes slideInRtl {
        from { opacity: 0; transform: translateX(10px); }
        to { opacity: 1; transform: translateX(0); }
    }
    .item-removed {
        transform: scale(0.95);
        opacity: 0;
        transition: all 0.3s ease;
    }
</style>

@section Scripts {
    <script>
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        const currencyEgp = '@Localizer["Currency_EGP"]';

        async function updateQty(productId, delta) {
            const qtyEl = document.querySelector(`.item-qty[data-product-id="${productId}"]`);
            if (!qtyEl) return;
            const currentQty = parseInt(qtyEl.textContent);
            const newQty = Math.max(1, currentQty + delta);
            if (newQty === currentQty) return;

            try {
                const response = await fetch('/api/v1/cart/update-quantity', {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId: productId, quantity: newQty })
                });
                const data = await response.json();
                if (data.success) {
                    updateCartBadge(data.data);
                    qtyEl.textContent = newQty;
                    recalculateTotals();
                }
            } catch (e) {
                console.error('Failed to update quantity:', e);
                window.location.reload();
            }
        }

        async function removeItem(productId, skipConfirm) {
            if (!skipConfirm) {
                const item = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
                if (item) item.classList.add('item-removed');
            }

            setTimeout(async () => {
                try {
                    const response = await fetch(`/api/v1/cart/remove/${productId}`, {
                        method: 'DELETE',
                        headers: { 'Content-Type': 'application/json' }
                    });
                    const data = await response.json();
                    if (data.success) {
                        updateCartBadge(data.data);
                        const item = document.querySelector(`.cart-item[data-product-id="${productId}"]`);
                        if (item) item.remove();
                        recalculateTotals();
                        checkIfEmpty();
                    }
                } catch (e) {
                    console.error('Failed to remove item:', e);
                    window.location.reload();
                }
            }, 300);
        }

        function recalculateTotals() {
            let subtotal = 0;
            let itemCount = 0;
            const items = document.querySelectorAll('.cart-item');

            items.forEach(item => {
                const qty = parseInt(item.querySelector('.item-qty').textContent);
                const price = parseFloat(item.dataset.price);
                const total = qty * price;
                subtotal += total;
                itemCount += qty;
                const totalEl = item.querySelector('.item-total');
                if (totalEl) totalEl.textContent = total.toFixed(2) + ' ' + currencyEgp;
            });

            const subtotalEl = document.getElementById('summary-subtotal');
            const totalEl = document.getElementById('summary-total');
            const itemsCountEl = document.getElementById('summary-items-count');
            const mobileStickyTotalEl = document.getElementById('mobile-sticky-total');

            const formattedTotal = Math.round(subtotal).toLocaleString('en-US') + ' ' + currencyEgp;
            if (subtotalEl) subtotalEl.textContent = formattedTotal;
            if (totalEl) totalEl.textContent = formattedTotal;
            if (itemsCountEl) itemsCountEl.textContent = itemCount;
            if (mobileStickyTotalEl) mobileStickyTotalEl.textContent = formattedTotal;
        }

        function checkIfEmpty() {
            const items = document.querySelectorAll('.cart-item');
            if (items.length === 0) {
                const stickyBar = document.getElementById('cart-mobile-sticky-bar');
                if (stickyBar) stickyBar.remove();
                window.location.reload();
            }
        }

        function updateCartBadge(count) {
            document.querySelectorAll('[id^="cart-badge"]').forEach(el => el.textContent = count || 0);
        }
    </script>
}
