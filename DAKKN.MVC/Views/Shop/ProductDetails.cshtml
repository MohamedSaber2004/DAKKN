@using DAKKN.MVC.ViewModels.Customer
@model ProductDetailsViewModel
@inject IStringLocalizer<Messages> Localizer
@{
    Layout = "_LayoutLanding";
    var product = Model.Product;
    var culture = System.Globalization.CultureInfo.CurrentCulture.Name;
    var isArabic = culture.StartsWith("ar");
    var isAr = isArabic;
    var baseUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var productUrl = $"{baseUrl}/shop/product/{product.Id}";
    var productImage = string.IsNullOrEmpty(product.ImageFullUrl) ? product.ImageUrl : product.ImageFullUrl;
    if (!string.IsNullOrEmpty(productImage) && !productImage.StartsWith("http"))
    {
        productImage = baseUrl + productImage;
    }

    // schema.org accepts an array here. Emitting every gallery image lets search engines index the
    // full set instead of only the cover. Serialized by the JSON encoder so quotes and slashes
    // in a filename cannot break out of the script block.
    var galleryImages = (product.Images is { Count: > 0 })
        ? product.Images.Where(i => !string.IsNullOrWhiteSpace(i)).ToList()
        : new List<string> { productImage };
    var jsonLdImages = System.Text.Json.JsonSerializer.Serialize(
        galleryImages.Select(i => i.StartsWith("http") ? i : baseUrl + i).ToList());
    var price = product.Price.ToString("F2");
    var availability = product.QuantityInStock > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock";
}

<!-- Product JSON-LD Schema -->
<script type="application/ld+json">
{
    "@@context": "https://schema.org",
    "@@type": "Product",
    "@@id": "@productUrl#product",
    "name": "@(isArabic ? product.ArName : product.Name)",
    "description": "@(isArabic ? product.ArDescription : product.Description)",
    "image": @Html.Raw(jsonLdImages),
    "url": "@productUrl",
    "brand": {
        "@@type": "Brand",
        "name": "DAKKN"
    },
    "sku": "@product.Id",
    "offers": {
        "@@type": "Offer",
        "@@id": "@productUrl#offer",
        "url": "@productUrl",
        "priceCurrency": "EGP",
        "price": "@price",
        "availability": "@availability",
        "seller": {
            "@@type": "Organization",
            "name": "DAKKN",
            "url": "@baseUrl"
        }
    },
    "aggregateRating": {
        "@@type": "AggregateRating",
        "ratingValue": "@product.AverageRating",
        "reviewCount": "@product.ReviewCount",
        "bestRating": "5",
        "worstRating": "1"
    },
    "category": "@(isArabic ? product.CategoryArName : product.CategoryName)"
}
</script>
<div class="min-h-screen bg-surface dark:bg-[#080e1a]">
    <nav class="fixed top-0 w-full z-50 flex justify-between items-center px-4 md:px-16 h-16 md:h-20 bg-surface/75 dark:bg-[#0a1020]/85 backdrop-blur-md border-b border-outline-variant/10 dark:border-white/5 shadow-sm">
        <a href="/shop/products" class="flex items-center gap-2 text-on-surface-variant dark:text-slate-300 hover:text-primary transition-colors font-bold text-sm">
            <span class="material-symbols-outlined text-lg">arrow_back</span>
            @Localizer["cart_continue_shopping"]
        </a>
        <div class="flex items-center gap-3">
            <a href="/shop/cart" class="relative flex items-center gap-2 bg-primary/10 hover:bg-primary text-primary hover:text-on-primary px-4 py-2 rounded-full text-xs font-bold transition-all" title="@Localizer["nav_cart"]">
                <span class="material-symbols-outlined text-lg">shopping_cart</span>
                <span class="absolute -top-1 -end-1 w-4 h-4 bg-tertiary-container text-on-tertiary-container text-[8px] font-bold rounded-full flex items-center justify-center shadow-sm" id="cart-badge">0</span>
            </a>
            <a asp-action="Login" asp-controller="Auth" class="text-xs font-bold text-on-surface-variant dark:text-slate-300 hover:text-primary transition-colors">@Localizer["auth.register.login"]</a>
            <a asp-action="Register" asp-controller="Auth" class="bg-primary text-on-primary text-xs font-bold px-5 py-2 rounded-full transition-all hover:-translate-y-0.5">@Localizer["auth.login.register"]</a>
            @await Html.PartialAsync("Partials/_ThemeToggle")
        </div>
    </nav>

    <div class="max-w-7xl mx-auto px-4 md:px-16 pt-28 pb-16">
        <nav class="flex items-center gap-2 text-sm text-on-surface-variant dark:text-slate-400 mb-8">
            <a asp-action="Products" asp-controller="Shop" class="hover:text-primary transition-colors">@Localizer["Product_Products"]</a>
            <span class="material-symbols-outlined text-xs">chevron_right</span>
            <span class="text-on-surface dark:text-white font-bold">@(isArabic ? product.ArName : product.Name)</span>
        </nav>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16">
            <div class="space-y-4">
                <partial name="Partials/_ProductGallery" model="product" />
            </div>

            <div class="flex flex-col">
                <div class="mb-8 pb-8 border-b border-outline-variant/10">
                    <div class="flex items-center gap-2 mb-4 flex-wrap">
                        <span class="bg-primary/10 text-primary px-4 py-1 rounded-full text-xs font-bold uppercase tracking-widest inline-block">@(isArabic ? product.CategoryArName : product.CategoryName)</span>
                        @if (product.IsFeatured)
                        {
                            <span class="bg-amber-500/15 text-amber-600 dark:text-amber-400 border border-amber-500/30 px-3 py-1 rounded-full text-xs font-bold inline-flex items-center gap-1">
                                <span class="material-symbols-outlined text-xs">star</span>
                                @Localizer["admin_product_featured_badge"]
                            </span>
                        }
                    </div>
                    <h1 class="text-3xl md:text-4xl font-extrabold text-on-surface dark:text-white mb-3">@(isArabic ? product.ArName : product.Name)</h1>
                    <div class="flex items-center gap-4">
                        <span class="text-3xl font-bold text-primary">@product.Price.ToString("N0") @Localizer["Currency_EGP"]</span>
                        <partial name="_ProductRatingWidget" model="@product.Id" />
                    </div>
                    <p class="text-on-surface-variant dark:text-slate-400 mt-6 leading-relaxed">
                        @(isArabic ? product.ArDescription : product.Description)
                    </p>
                    
                    <!-- Stock Info -->
                    <div class="mt-4 mb-4">
                        @if (product.QuantityInStock == 0)
                        {
                            <div class="flex items-center gap-2 text-red-500">
                                <span class="material-symbols-outlined">block</span>
                                <span class="font-bold text-sm">@Localizer["inventory_out_of_stock"]</span>
                            </div>
                        }
                        else if (product.QuantityInStock <= product.DangerQuantity)
                        {
                            <div class="flex items-center gap-2 text-amber-500">
                                <span class="material-symbols-outlined">warning</span>
                                <span class="font-bold text-sm">@Localizer["inventory_only_x_left", product.QuantityInStock]</span>
                            </div>
                        }
                        else
                        {
                            <div class="flex items-center gap-2 text-green-500">
                                <span class="material-symbols-outlined">check_circle</span>
                                <span class="font-bold text-sm">@Localizer["inventory_in_stock"]</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mt-auto">
                    @if (product.QuantityInStock > 0)
                    {
                        <button type="button" onclick="guestBuyNow(this, '@product.Id', '@(isArabic ? product.ArName : product.Name)', '@product.Price', '@(product.ImageFullUrl ?? product.ImageUrl)', '/shop/checkout')"
                                class="flex-1 bg-primary text-on-primary h-14 rounded-2xl font-bold text-base shadow-medium hover:shadow-large hover:scale-[1.01] active:scale-95 transition-all flex items-center justify-center gap-2.5">
                            <span class="material-symbols-outlined text-xl">bolt</span>
                            @Localizer["Product_BuyNow"]
                        </button>
                        <button type="button" onclick="guestAddToCart(this, '@product.Id', '@(isArabic ? product.ArName : product.Name)', '@product.Price', '@(product.ImageFullUrl ?? product.ImageUrl)')"
                                class="flex-1 bg-primary/10 hover:bg-primary text-primary hover:text-on-primary border border-primary/20 h-14 rounded-2xl font-bold text-base shadow-sm hover:shadow-medium transition-all flex items-center justify-center gap-2.5">
                            <span class="material-symbols-outlined text-xl">shopping_cart</span>
                            @Localizer["Product_AddToCart"]
                        </button>
                    }
                    else
                    {
                        <button disabled class="flex-1 bg-gray-300 dark:bg-white/10 text-gray-500 dark:text-slate-400 h-14 rounded-2xl font-bold text-base cursor-not-allowed flex items-center justify-center gap-3">
                            <span class="material-symbols-outlined">block</span>
                            @Localizer["inventory_out_of_stock"]
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Cart Toast Container -->
<div id="cart-toast-container" class="fixed bottom-24 md:bottom-8 end-4 md:end-8 z-[90] flex flex-col gap-3 pointer-events-none"></div>

<!-- Related Products -->
@{
    var relatedViewData = new ViewDataDictionary(ViewData) { { "ContainerClass", "max-w-7xl mx-auto px-4 md:px-16 pb-16" }, { "DetailsRoute", "/shop/product/" } };
}
<partial name="Partials/_RelatedProducts" model="Model.RelatedProducts" view-data="@relatedViewData" />
